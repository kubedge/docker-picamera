# Required secrets. List one KEY=description per line.
# Real values live in macOS Keychain under service: com.kubedge.docker-picamera
# Populate: `bin/set-secret.sh <KEY>`           # one key, interactive
#           `bin/set-secret.sh --bootstrap`     # walk every key
# Load:     `source bin/load-secrets.sh`
#
# Example:
# ANTHROPIC_API_KEY=Used by /security and Claude Code.
# DATABASE_URL=Production database connection string.

DOCKERHUB_USERNAME=Docker Hub account that publishes kubedge/picamera from .github/workflows/image.yml (GitHub Actions secret).
DOCKERHUB_TOKEN=Docker Hub access token with write access to kubedge/picamera (GitHub Actions secret).
