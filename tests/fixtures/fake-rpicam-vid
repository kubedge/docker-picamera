#!/usr/bin/env python3
"""Fake `rpicam-vid -o -` for the Rust conformance tests: MJPEG on stdout at --framerate.
See tests/fixtures/fakecam/_fakeframes.py for the FAKECAM_* controls."""

import json
import os
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "fakecam"))
from _fakeframes import frame_limit, jpeg  # noqa: E402


def main() -> int:
    argv = sys.argv[1:]
    if path := os.environ.get("FAKECAM_ARGV_FILE"):
        Path(path).write_text(json.dumps(argv))
    if path := os.environ.get("FAKECAM_PID_FILE"):
        Path(path).write_text(str(os.getpid()))
    fps = int(argv[argv.index("--framerate") + 1]) if "--framerate" in argv else 30
    limit, exit_after = frame_limit(), os.environ.get("FAKECAM_EXIT_AFTER")
    garbage = os.environ.get("FAKECAM_GARBAGE") == "1"
    out = sys.stdout.buffer
    n = 0
    while True:
        time.sleep(1 / fps)
        if exit_after and n >= int(exit_after):
            print(f"fake rpicam-vid: exiting after {n} frames", file=sys.stderr)
            return 3
        if limit is not None and n >= limit:
            continue
        n += 1
        if garbage:
            out.write(b"\x00garbage\xff\x00")
        out.write(jpeg(n))
        out.flush()


if __name__ == "__main__":
    try:
        sys.exit(main())
    except BrokenPipeError:
        sys.exit(0)
